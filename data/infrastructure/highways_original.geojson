    {
      "type": "Feature",
      "properties": {
        "name": "I-69/US-59 (Eastex Freeway)",
        "designation": "I-69/US-59 North",
        "construction_year": 1955,
        "completion_year": 1960,
        "decade": "1960s",
        "neighborhoods_displaced": [
          "Fifth Ward",
          "Denver Harbor"
        ],
        "description": "The Eastex Freeway further fragmented the Fifth Ward, already damaged by I-45 North, and cut through Denver Harbor, a neighborhood with significant Latino and working-class white populations. Combined with the North Freeway, the two expressways left the Fifth Ward hemmed in by concrete on multiple sides, contributing to decades of disinvestment."
