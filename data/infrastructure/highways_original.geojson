      "properties": {
        "name": "I-45 (Gulf Freeway)",
        "designation": "I-45 South",
        "construction_year": 1948,
        "completion_year": 1952,
        "decade": "1950s",
        "neighborhoods_displaced": [
          "South Houston",
          "South Park",
          "Gulfgate"
        ],
        "description": "The Gulf Freeway was the first freeway built in Texas and one of the earliest in the American South. Originally conceived as a high-speed corridor linking downtown Houston to the petrochemical refineries along Galveston Bay, its construction displaced families in several working-class neighborhoods south of downtown."
